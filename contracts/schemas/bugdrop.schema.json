{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BugDrop",
  "type": "object",
  "required": ["bugdrop_id","client_id","review_id","artifact_id","category","summary","severity","status"],
  "properties": {
    "bugdrop_id": {"type":"string","pattern":"^BUG-[A-Za-z0-9._-]+$"},
    "client_id": {"type":"string"},
    "review_id": {"type":"string"},
    "artifact_id": {"type":"string"},
    "category": {"enum":["visual","ux","content","business-rule","integration","data","security","performance","accessibility"]},
    "summary": {"type":"string","minLength":1},
    "details": {"type":"string"},
    "severity": {"enum":["low","medium","high","critical"]},
    "affected_capabilities": {"type":"array","items":{"type":"string"}},
    "affected_domains": {"type":"array","items":{"type":"string"}},
    "affected_surfaces": {"type":"array","items":{"type":"string"}},
    "screenshot_ref": {"type":"string"},
    "status": {"enum":["open","triaged","change-contract-created","resolved","rejected"]}
  },
  "additionalProperties": true
}
