{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capture Manifest",
  "type": "object",
  "required": ["capture_id","client_id","build_id","direction_id","targets","status"],
  "properties": {
    "capture_id": {"type":"string"},
    "client_id": {"type":"string"},
    "build_id": {"type":"string"},
    "direction_id": {"type":"string"},
    "targets": {
      "type":"array",
      "items":{
        "type":"object",
        "required":["surface","runtime","viewport","state","output"],
        "properties":{
          "surface":{"type":"string"},
          "runtime":{"enum":["flutter","web","admin","external"]},
          "viewport":{"type":"string"},
          "state":{"type":"string"},
          "output":{"type":"string"}
        }
      }
    },
    "status": {"enum":["planned","captured","failed"]}
  },
  "additionalProperties": true
}
