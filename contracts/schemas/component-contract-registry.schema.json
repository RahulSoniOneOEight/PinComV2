{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "client_id",
    "components",
    "status"
  ],
  "properties": {
    "client_id": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "semantic_role",
          "variants",
          "states",
          "tokens",
          "implementation",
          "accessibility",
          "qa"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "semantic_role": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation": {
            "type": "object",
            "properties": {
              "flutter": {
                "type": "string"
              },
              "web": {
                "type": "string"
              }
            },
            "anyOf": [
              {
                "required": [
                  "flutter"
                ]
              },
              {
                "required": [
                  "web"
                ]
              }
            ],
            "description": "Per-platform implementation strings. A component needs at least one platform; web-only surfaces (commerce-admin, erp, ops-console, analytics, seller-portal) must not be forced to declare a Flutter implementation."
          },
          "accessibility": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qa": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "status": {
      "enum": [
        "generated",
        "review-ready",
        "approved"
      ]
    }
  },
  "additionalProperties": false
}
