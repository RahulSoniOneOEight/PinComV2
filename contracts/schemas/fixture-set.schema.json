{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixture Set",
  "type": "object",
  "required": ["fixture_set_id","client_id","states"],
  "properties": {
    "fixture_set_id": {"type":"string"},
    "client_id": {"type":"string"},
    "states": {
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["id","purpose"],
        "properties":{
          "id":{"type":"string"},
          "purpose":{"type":"string"},
          "data":{"type":"object"}
        }
      }
    }
  },
  "additionalProperties": true
}
