{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Observability Evidence",
  "type":"object",
  "required":["evidence_id","candidate_id","signals","status"],
  "properties":{
    "evidence_id":{"type":"string"},
    "candidate_id":{"type":"string"},
    "signals":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["kind","name","status"],
        "properties":{
          "kind":{"enum":["metric","trace","log","error","alert"]},
          "name":{"type":"string"},
          "status":{"enum":["pass","fail","warning","not-run"]},
          "evidence":{"type":"string"}
        }
      }
    },
    "status":{"enum":["draft","failed","passed"]}
  },
  "additionalProperties":true
}
