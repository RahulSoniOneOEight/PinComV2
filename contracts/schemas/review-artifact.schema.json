{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Artifact",
  "type": "object",
  "required": ["artifact_id", "client_id", "surface", "environment", "build_identity", "comments", "approval_status"],
  "properties": {
    "artifact_id": {"type": "string"},
    "client_id": {"type": "string"},
    "surface": {"type": "string"},
    "route_or_screen": {"type": "string"},
    "environment": {"enum": ["prototype", "dev", "staging", "production"]},
    "build_identity": {"type": "string"},
    "journey": {"type": "string"},
    "viewport": {"type": "string"},
    "preview_url": {"type": "string"},
    "screenshot_ref": {"type": "string"},
    "direction": {"type": "string"},
    "comments": {"type": "array"},
    "approval_status": {"enum": ["pending", "approved", "changes-requested", "rejected"]}
  },
  "additionalProperties": true
}
