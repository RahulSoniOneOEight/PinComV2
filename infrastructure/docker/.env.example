# Staging compose overrides. Copy to `.env` next to docker-compose.staging.yml.
# These are local development defaults, not production secrets. Never commit real credentials.

# Host port mappings (container ports stay canonical).
POSTGRES_PORT=5432
VALKEY_PORT=6379
MEILI_PORT=7700

# PostgreSQL credentials for the local staging database.
POSTGRES_DB=pincommerce
POSTGRES_USER=pincommerce
POSTGRES_PASSWORD=pincommerce

# Meilisearch development master key.
MEILI_MASTER_KEY=dev-master-key

# Medusa provider (image built from the client's Medusa project).
MEDUSA_IMAGE=pincommerce-medusa:staging
MEDUSA_PORT=9000
MEDUSA_DB=pincommerce_medusa

# Medusa dev-only defaults. Override locally with strong random values; never
# commit real secrets.
MEDUSA_JWT_SECRET=dev-jwt-secret
MEDUSA_COOKIE_SECRET=dev-cookie-secret

# Tryton provider.
TRYTON_IMAGE=tryton/tryton:8.0
TRYTON_PORT=8000
TRYTON_DB=tryton
# Dev-only admin password used only by the one-shot `tryton-init` service.
TRYTON_ADMIN_PASSWORD=admin
